DATABASE_URL="postgresql://your_user@localhost:5432/inland_green?schema=public"
TEST_DATABASE_URL="postgresql://your_user@localhost:5432/inland_green_test?schema=public"

# Runtime (RLS) connection: a non-superuser role without BYPASSRLS so row-level
# security is enforced. Constructed by swapping these into DATABASE_URL.
APP_DB_USER="inland_app"
APP_DB_PASSWORD="replace-with-a-long-random-password"
JWT_SECRET=replace-me-with-a-long-random-string
NEXT_PUBLIC_APP_NAME="Inland Green Bank"
